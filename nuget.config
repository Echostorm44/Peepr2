<?xml version="1.0" encoding="utf-8"?>
<!-- Development only: local Cascade.UI / Etch builds packed into F:\Code\LocalNuGet while their
     changes are iterated on. Removed once those versions are published to nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-echostorm" value="F:\Code\LocalNuGet" />
  </packageSources>
</configuration>
